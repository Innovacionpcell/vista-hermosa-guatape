# ─────────────────────────────────────────────────────────────────────────────
# Lotes Campestres Vista Hermosa — variables de entorno
# Copia este archivo a .env y rellena los valores. .env NUNCA se commitea.
# ─────────────────────────────────────────────────────────────────────────────

# Dominio público del sitio. Se usa en canonical, og:url y sitemap.xml.
# Ya está como fallback en astro.config.mjs, así que el build es correcto aunque
# esta variable no exista. Definirla solo para apuntar a un entorno de pruebas.
PUBLIC_SITE_URL=https://lotescampestresguatape.com

# Número de WhatsApp en formato internacional sin "+" ni espacios.
PUBLIC_WHATSAPP=573105145648

# Analítica. Si el ID queda vacío, el script NO se inyecta (ver BaseLayout).
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Backend del formulario
#
# ATENCIÓN: el hosting es Node 22, no PHP. El proxy en PHP que describía el brief
# original NO se puede ejecutar en este entorno. El backend se replantea en la
# Etapa 6 (probablemente un endpoint de Astro con adaptador de Node, o un
# servicio externo). Estas dos variables se mantienen porque el CRM sigue siendo
# el destino del lead, sea cual sea el mecanismo.
#
# El secreto NUNCA debe quedar expuesto al navegador: la variable no lleva el
# prefijo PUBLIC_ justamente para que Astro no la incluya en el bundle cliente.
# ─────────────────────────────────────────────────────────────────────────────

# TODO: pedir al cliente la URL del webhook del CRM.
CRM_WEBHOOK_URL=PENDIENTE_URL_WEBHOOK_CRM

# Secreto compartido para firmar el payload con HMAC-SHA256 (cabecera X-Signature).
CRM_WEBHOOK_SECRET=
