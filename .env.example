# ─────────────────────────────────────────────────────────────────────────────
# Lotes Campestres Vista Hermosa — variables de entorno
# Copia este archivo a .env y rellena los valores. .env NUNCA se commitea.
# ─────────────────────────────────────────────────────────────────────────────

# Dominio público del sitio. Se usa en canonical, og:url y sitemap.xml.
# Ya está como fallback en astro.config.mjs, así que el build es correcto aunque
# esta variable no exista. Definirla solo para apuntar a un entorno de pruebas.
PUBLIC_SITE_URL=https://lotescampestresguatape.com

# Número de WhatsApp en formato internacional sin "+" ni espacios.
PUBLIC_WHATSAPP=573105145648

# Analítica. Si el ID queda vacío, el script NO se inyecta (ver BaseLayout).
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Backend del formulario — /api/lead (endpoint de Astro, adaptador de Node)
#
# Estas dos variables se leen EN SERVIDOR y no llevan prefijo PUBLIC_, así que
# Astro nunca las incluye en el bundle del navegador. En produccion se definen
# en hPanel: Node.js app -> Environment variables.
#
# El endpoint funciona aunque el webhook todavia NO exista: en ese caso el lead
# se guarda igual en el respaldo en disco y el visitante ve exito. Nada se pierde
# mientras se define el CRM.
# ─────────────────────────────────────────────────────────────────────────────

# URL del webhook del CRM propio. Mientras empiece por PENDIENTE o este vacia,
# el endpoint no intenta enviar y marca el lead como "sin-configurar".
CRM_WEBHOOK_URL=PENDIENTE_URL_WEBHOOK_CRM

# Secreto compartido. Si se define, cada peticion al CRM viaja firmada con
# HMAC-SHA256 en la cabecera X-Signature para que el receptor pueda verificarla.
CRM_WEBHOOK_SECRET=

# Carpeta donde el servidor escribe el respaldo de leads y el rate limit.
# Por defecto <raiz del proyecto>/.data, que queda FUERA de dist/client y por
# tanto no es accesible por HTTP. Contiene datos personales: nunca versionarla.
LEADS_DATA_DIR=

# Puerto y host del servidor standalone. Hostinger suele inyectar PORT solo;
# definirlos aqui solo hace falta en local o si el panel no lo hace.
# PORT=4321
# HOST=0.0.0.0
