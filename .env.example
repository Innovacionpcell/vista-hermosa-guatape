# ─────────────────────────────────────────────────────────────────────────────
# Lotes Campestres Vista Hermosa — variables de entorno
# Copia este archivo a .env y rellena los valores. .env NUNCA se commitea.
# ─────────────────────────────────────────────────────────────────────────────

# Dominio público del sitio. Se usa en canonical, og:url y sitemap.xml.
# TODO: confirmar el dominio definitivo con el cliente.
PUBLIC_SITE_URL=https://PENDIENTE.com

# Número de WhatsApp en formato internacional sin "+" ni espacios.
PUBLIC_WHATSAPP=573105145648

# Analítica. Si el ID queda vacío, el script NO se inyecta (ver BaseLayout).
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Backend del formulario (public/api/lead.php)
#
# IMPORTANTE: estas dos variables NO se definen aquí en producción.
# Viven en un archivo PHP fuera de public_html (ej. /home/uXXXX/config/crm.php)
# que lead.php incluye con require_once. Así el secreto no es accesible por HTTP
# ni viaja en el repositorio. Se sube UNA sola vez a mano por el Administrador
# de archivos de hPanel. Ver README.md → Despliegue.
# ─────────────────────────────────────────────────────────────────────────────

# TODO: pedir al cliente la URL del webhook del CRM.
CRM_WEBHOOK_URL=PENDIENTE_URL_WEBHOOK_CRM

# Secreto compartido para firmar el payload con HMAC-SHA256 (cabecera X-Signature).
CRM_WEBHOOK_SECRET=
