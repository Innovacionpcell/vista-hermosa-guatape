# dependencias
node_modules/

# build
dist/
.astro/

# entorno — NUNCA commitear credenciales ni la URL del webhook del CRM
.env
.env.*
!.env.example

# Datos que escribe el servidor en runtime: respaldo de leads y rate limit.
# Viven fuera de dist/, no se sirven por HTTP y NUNCA se versionan: contienen
# datos personales de los visitantes.
.data/
*.jsonl

# Carpeta original de assets que acompañaba al brief. Su contenido ya está
# copiado byte a byte en public/img/, que sí se versiona porque es lo que se
# despliega. Versionar las dos duplicaría 10 MB en el repositorio.
public-img/

# sistema
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# capturas de la auditoria movil
capturas-movil/

# editores y herramientas locales
.vscode/
.idea/
.claude/
