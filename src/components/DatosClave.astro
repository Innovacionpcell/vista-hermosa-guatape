---
import { proyecto, inventario, formatearCOP, formatearNumero } from "../data/proyecto";
import Icono from "./Icono.astro";
import type { NombreIcono } from "./iconos";

/**
 * Barra de datos clave. Fondo crema, 4 columnas → 2 en móvil.
 *
 * EL PRECIO TOTAL DEL LOTE ES LA CIFRA DOMINANTE. La unidad comercial es el
 * lote, no el metro cuadrado: el $/m² real del inventario va de $10.990 a
 * $106.959 y como cifra suelta no dice nada (ver la regla 1 de lotes.ts). El
 * valor por m² aparece dentro de la ficha de cada lote, donde sí tiene contexto.
 *
 * El "desde" que se pinta aquí es el de CAMPAÑA, el mismo del h1 del hero, no el
 * mínimo calculado del inventario: un "desde" que cambia de número entre el
 * titular y la barra de datos de la misma pantalla se lee como un error. Las
 * cifras reales lote por lote están tres secciones más abajo.
 */

interface Dato {
  icono: NombreIcono;
  valor: string;
  etiqueta: string;
  dominante?: boolean;
}

const datos: Dato[] = [
  {
    icono: "lotes",
    valor: String(inventario.disponibles),
    etiqueta: "Lotes disponibles",
  },
  {
    icono: "area",
    valor: `${formatearNumero(inventario.areaMin)} – ${formatearNumero(inventario.areaMax)}`,
    etiqueta: "Metros cuadrados por lote",
  },
  {
    icono: "precio",
    valor: `Desde ${formatearCOP(proyecto.precioDesdeComercial)}`,
    etiqueta: "Precio por lote",
    dominante: true,
  },
  {
    icono: "reloj",
    valor: proyecto.tiempoAGuatape,
    etiqueta: `De ${proyecto.ciudad}`,
  },
];
---

<section id="datos-clave" class="bg-crema" aria-label="Datos clave del proyecto">
  <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-16">
    <dl class="grid grid-cols-2 gap-x-4 gap-y-9 sm:gap-x-6 lg:grid-cols-4 lg:gap-x-10">
      {
        datos.map((dato) => (
          <div
            class={`flex flex-col items-start gap-2.5 border-l pl-3.5 sm:gap-3 sm:pl-5 ${
              dato.dominante ? "border-dorado-600" : "border-dorado-500/40"
            }`}
          >
            <Icono
              nombre={dato.icono}
              tamano={26}
              class={dato.dominante ? "text-dorado-600" : "text-verde-700"}
            />

            <dd
              class={`font-serif leading-tight ${
                dato.dominante
                  ? "text-xl text-dorado-600 sm:text-3xl lg:text-4xl"
                  : "text-lg text-verde-800 sm:text-2xl lg:text-3xl"
              }`}
              set:html={dato.valor.replace(/m2/g, "m&sup2;")}
            />

            <dt class="font-sans text-[0.7rem] tracking-[0.16em] text-texto/60 uppercase">
              {dato.etiqueta}
            </dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>
