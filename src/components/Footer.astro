---
import { proyecto } from "../data/proyecto";
import { logo, logoConstructora } from "../data/galeria";
import Icono from "./Icono.astro";

/**
 * Footer. Incluye la nota legal obligatoria y el aviso de tratamiento de datos.
 *
 * La nota legal no es decorativa: en venta de lotes sobre plano, decir que los
 * renders son ilustrativos y que áreas y precios están sujetos a verificación
 * es lo que separa una pieza publicitaria correcta de una oferta comercial
 * vinculante.
 *
 * TRES CRÉDITOS QUE NO SE PUEDEN CONFUNDIR, y por eso van en tres filas propias
 * separadas por filetes, no apretados en una:
 *   1. La marca del proyecto (logo Vista Hermosa), arriba con la navegación.
 *   2. La CONSTRUCTORA (logo R&U Ingenieros), en su propia franja y con su
 *      propio antetítulo. Es quien construye: merece peso visual propio.
 *   3. Quien hizo el sitio (Growth Digital), en letra pequeña abajo del todo.
 * Amontonar 2 y 3 en la misma línea haría parecer que R&U hizo la web o que
 * Growth Digital construye lotes. En móvil cada una ocupa su fila completa.
 */

const { lat, lng } = proyecto.coordenadas;
const anio = new Date().getFullYear();

const enlaces = [
  { href: "#ubicacion", texto: "Ubicación" },
  { href: "#recorrido-360", texto: "Recorrido 360°" },
  { href: "#galeria", texto: "Galería" },
  { href: "#lotes", texto: "Lotes" },
  { href: "#faq", texto: "Preguntas frecuentes" },
  { href: "#contacto", texto: "Contacto" },
];

// TODO: el cliente debe entregar la URL de Growth Digital. No se inventa un
// dominio: mientras sea PENDIENTE, el crédito va como texto sin enlace.
const growthUrl = "PENDIENTE";
const hayGrowthUrl = !growthUrl.startsWith("PENDIENTE");
---

<footer class="bg-verde-900">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr_1fr]">
      {/* Marca */}
      <div>
        <div class="flex items-center gap-3.5">
          <img
            src={logo.emblema.src}
            alt=""
            width={logo.emblema.ancho}
            height={logo.emblema.alto}
            class="h-14 w-auto"
            loading="lazy"
            decoding="async"
          />
          <span class="flex flex-col leading-none">
            <span class="font-serif text-lg tracking-[0.18em] text-dorado-400 uppercase">
              Vista Hermosa
            </span>
            <span
              class="mt-1.5 font-sans text-[0.5rem] tracking-[0.34em] text-dorado-500 uppercase"
            >
              {proyecto.ciudad}
            </span>
          </span>
        </div>

        <p class="mt-6 max-w-xs font-sans text-sm leading-relaxed text-crema/55">
          Lotes campestres en el sector {proyecto.sector}, a {proyecto.tiempoAGuatape} de{" "}
          {proyecto.ciudad}, {proyecto.departamento}.
        </p>
      </div>

      {/* Navegación */}
      <nav aria-label="Enlaces del pie">
        <h3 class="font-sans text-[0.65rem] tracking-[0.2em] text-dorado-400/70 uppercase">
          Secciones
        </h3>
        <ul class="mt-5 space-y-3">
          {
            enlaces.map((enlace) => (
              <li>
                <a
                  href={enlace.href}
                  class="font-sans text-sm text-crema/60 transition-colors duration-200 hover:text-dorado-400"
                >
                  {enlace.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Contacto */}
      <div>
        <h3 class="font-sans text-[0.65rem] tracking-[0.2em] text-dorado-400/70 uppercase">
          Contacto
        </h3>

        <ul class="mt-5 space-y-4">
          <li>
            <a
              href={`tel:+${proyecto.whatsapp}`}
              class="inline-flex items-center gap-2.5 font-sans text-sm text-crema/60 transition-colors duration-200 hover:text-dorado-400"
            >
              <Icono nombre="telefono" tamano={15} class="text-dorado-400" />
              {proyecto.whatsappDisplay}
            </a>
          </li>
          <li>
            <a
              href={proyecto.googleMaps}
              target="_blank"
              rel="noopener"
              class="inline-flex items-start gap-2.5 font-sans text-sm text-crema/60 transition-colors duration-200 hover:text-dorado-400"
            >
              <Icono nombre="mapa" tamano={15} class="mt-0.5 shrink-0 text-dorado-400" />
              <span>
                {proyecto.sector}, {proyecto.ciudad}
                <span class="mt-1 block font-mono text-[0.7rem] text-crema/35">
                  {lat}, {lng}
                </span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* ── Constructora ───────────────────────────────────────────────── */}
    {/* width/height son las dimensiones REALES del archivo (600×467). Con
        `h-auto` el navegador deriva de ahí la proporción y reserva la caja antes
        de descargar la imagen, así que el logo no empuja el footer al cargar.
        El ancho de pantalla lo fija el CSS: 140 px en móvil, 180 px desde sm. */}
    <div class="mt-14 border-t border-dorado-500/20 pt-10">
      <p class="font-sans text-[0.65rem] tracking-[0.2em] text-dorado-400/70 uppercase">
        Proyecto desarrollado por
      </p>

      <a
        href={proyecto.constructora.url}
        target="_blank"
        rel="noopener"
        data-evento="constructora_click"
        class="mt-5 inline-block rounded-sm transition-opacity duration-200 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-dorado-400"
      >
        <img
          src={logoConstructora.src}
          srcset={logoConstructora.srcset}
          sizes="(min-width: 640px) 180px, 140px"
          alt={logoConstructora.alt}
          width={logoConstructora.ancho}
          height={logoConstructora.alto}
          loading="lazy"
          decoding="async"
          class="h-auto w-[140px] sm:w-[180px]"
        />
      </a>
    </div>

    {/* ── Nota legal ─────────────────────────────────────────────────── */}
    <div class="mt-10 space-y-3 border-t border-dorado-500/20 pt-8">
      <p class="max-w-4xl font-sans text-[0.7rem] leading-relaxed text-crema/40">
        Las imágenes de render son ilustrativas y no constituyen oferta comercial. Áreas y
        precios están sujetos a disponibilidad y a verificación en el levantamiento
        topográfico. Las áreas publicadas son área licencia y el precio indicado corresponde
        al lote completo.
      </p>
      <p class="max-w-4xl font-sans text-[0.7rem] leading-relaxed text-crema/40">
        Los datos personales que nos compartas se tratan conforme a la Ley 1581 de 2012 y
        se usan únicamente para contactarte sobre este proyecto.
      </p>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-dorado-500/15 pt-7 font-sans text-xs text-crema/35 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {anio} {proyecto.nombre}</p>
      <p>
        Sitio web por{" "}
        {
          hayGrowthUrl ? (
            <a
              href={growthUrl}
              class="text-dorado-400/80 transition-colors duration-200 hover:text-dorado-400"
            >
              Growth Digital
            </a>
          ) : (
            <span class="text-dorado-400/80">Growth Digital</span>
          )
        }
      </p>
    </div>
  </div>
</footer>
