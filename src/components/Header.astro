---
import { proyecto } from "../data/proyecto";
import { logo } from "../data/galeria";
import Icono from "./Icono.astro";

/**
 * Header transparente sobre el hero, sólido verde-800 al hacer scroll.
 *
 * NOTA DE ARQUITECTURA — por qué el menú móvil NO es una isla React.
 * El brief pedía isla React para el menú móvil, pero también fija un
 * presupuesto no negociable de JS inicial < 60 KB gzip. El runtime de React 19
 * pesa ~61 KB gzip por sí solo, y un header es visible desde el primer píxel:
 * ni client:visible ni client:idle lo sacan de la carga inicial. Un menú que
 * abre y cierra un panel son ~25 líneas de JS inline. React se reserva para las
 * islas que sí viven abajo en la página —calculadora, formulario, lightbox,
 * filtro— donde client:visible mantiene el coste en cero hasta que hacen falta.
 */

const enlaces = [
  { href: "#ubicacion", texto: "Ubicación" },
  { href: "#recorrido-360", texto: "Recorrido 360°" },
  { href: "#lotes", texto: "Lotes" },
  { href: "#contacto", texto: "Contacto" },
];

/*
 * El WhatsApp del header se sustituyó por un enlace de LLAMADA. WhatsApp ya
 * tiene dos puntos de entrada permanentes (el botón flotante y la barra CTA
 * móvil); repetirlo aquí era la tercera vez. El teléfono cubre a quien prefiere
 * hablar, y en móvil `tel:` marca directamente.
 */
---

<header
  id="header"
  data-solido="false"
  class="fixed inset-x-0 top-0 z-40 transition-colors duration-300 data-[solido=true]:bg-verde-800 data-[solido=true]:shadow-[0_1px_0_0_rgba(227,203,167,0.18)]"
>
  <div class="mx-auto flex h-24 max-w-7xl items-center justify-between gap-6 px-5 sm:px-8">
    {/*
      Lockup del header: emblema + nombre como texto.

      El logo original es un lockup VERTICAL —emblema circular, "VISTA HERMOSA"
      debajo y "GUATAPE" con filetes al pie—. En una barra de 80 px el conjunto
      cabe a unos 60 px de alto, con lo que la línea "GUATAPE" queda en ~4 px:
      ilegible a cualquier tamaño que quepa aquí. Por eso se usa solo el emblema
      (recortado del logo dorado a un asset propio) y el nombre se compone como
      texto en Cormorant, que además escala nítido y pesa cero.

      El <img> va con alt="" a propósito: es decorativo, porque el texto de al
      lado ya da el nombre accesible del enlace. Un alt con el nombre lo haría
      leerse dos veces en un lector de pantalla.
    */}
    <a
      href="#inicio"
      class="flex shrink-0 items-center gap-3 sm:gap-4"
      aria-label={`${proyecto.nombre}, ${proyecto.ciudad} — inicio`}
    >
      <img
        src={logo.emblema.src}
        alt=""
        width="174"
        height="160"
        class="h-14 w-auto sm:h-[4.25rem]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      <span class="flex flex-col leading-none">
        <span
          class="font-serif text-[1.2rem] tracking-[0.18em] text-dorado-400 uppercase sm:text-2xl"
        >
          Vista Hermosa
        </span>
        {/* Eco del tratamiento de "GUATAPE" en el logo: filetes a los lados */}
        <span
          aria-hidden="true"
          class="mt-1.5 flex items-center gap-2 font-sans text-[0.5rem] tracking-[0.34em] text-dorado-500 uppercase sm:text-[0.55rem]"
        >
          <span class="h-px w-3 bg-dorado-500/50 sm:w-4"></span>
          {proyecto.ciudad}
          <span class="h-px w-3 bg-dorado-500/50 sm:w-4"></span>
        </span>
      </span>
    </a>

    <!-- Navegación de escritorio -->
    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="flex items-center gap-9">
        {
          enlaces.map((enlace) => (
            <li>
              <a
                href={enlace.href}
                class="font-sans text-[0.7rem] font-medium tracking-[0.18em] text-crema uppercase transition-colors duration-200 hover:text-dorado-400"
              >
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      {/* Llamada directa. En móvil `tel:` abre el marcador del teléfono. */}
      <a
        href={`tel:+${proyecto.whatsapp}`}
        data-evento="telefono_click"
        data-origen="header"
        aria-label={`Llamar al ${proyecto.whatsappDisplay}`}
        class="inline-flex items-center gap-2.5 rounded-sm border border-dorado-500 px-4 py-2.5 font-sans text-[0.75rem] font-medium tracking-[0.1em] text-dorado-400 transition-colors duration-200 hover:border-dorado-400 hover:bg-dorado-400/10"
      >
        <Icono nombre="telefono" tamano={17} />
        <span>{proyecto.whatsappDisplay}</span>
      </a>

      <!-- Hamburguesa: solo móvil y tablet -->
      <button
        id="boton-menu"
        type="button"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        class="group inline-flex h-11 w-11 items-center justify-center rounded-sm text-crema transition-colors duration-200 hover:text-dorado-400 lg:hidden"
      >
        <Icono nombre="menu" tamano={24} class="group-aria-expanded:hidden" />
        <Icono nombre="cerrar" tamano={24} class="hidden group-aria-expanded:block" />
      </button>
    </div>
  </div>

  <!-- Panel móvil -->
  <nav
    id="menu-movil"
    aria-label="Navegación móvil"
    hidden
    class="border-t border-dorado-500/25 bg-verde-800 lg:hidden"
  >
    <ul class="mx-auto max-w-7xl px-5 py-3 sm:px-8">
      {
        enlaces.map((enlace) => (
          <li class="border-b border-dorado-500/12 last:border-0">
            <a
              href={enlace.href}
              class="block py-4 font-sans text-sm tracking-[0.14em] text-crema uppercase transition-colors duration-200 hover:text-dorado-400"
            >
              {enlace.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    var header = document.getElementById("header");
    var boton = document.getElementById("boton-menu");
    var menu = document.getElementById("menu-movil");
    if (!header || !boton || !menu) return;

    /* ── Estado sólido al hacer scroll ──────────────────────────────────
       Un sentinel + IntersectionObserver en vez de escuchar scroll: el
       navegador no ejecuta JS en cada píxel desplazado. */
    var sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:0;height:64px;width:1px;pointer-events:none";
    document.body.prepend(sentinel);

    new IntersectionObserver(
      function (entradas) {
        header.dataset.solido = entradas[0].isIntersecting ? "false" : "true";
      },
      { threshold: 0 }
    ).observe(sentinel);

    /* ── Menú móvil ─────────────────────────────────────────────────── */
    function alternar(abrir) {
      boton.setAttribute("aria-expanded", String(abrir));
      boton.setAttribute("aria-label", abrir ? "Cerrar menú" : "Abrir menú");
      menu.hidden = !abrir;
      /* Con el panel abierto el header siempre va sólido: si no, el menú
         flota sobre la foto del hero y el texto se vuelve ilegible. */
      if (abrir) header.dataset.solido = "true";
    }

    boton.addEventListener("click", function () {
      alternar(boton.getAttribute("aria-expanded") !== "true");
    });

    /* Al elegir una sección el menú se cierra solo */
    menu.addEventListener("click", function (e) {
      if (e.target.closest("a")) alternar(false);
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && boton.getAttribute("aria-expanded") === "true") {
        alternar(false);
        boton.focus();
      }
    });

    /* Al pasar a escritorio el panel debe quedar cerrado y no dejar el
       aria-expanded en true sobre un botón que ya no se ve */
    matchMedia("(min-width: 1024px)").addEventListener("change", function (e) {
      if (e.matches) alternar(false);
    });
  })();
</script>
