---
import {
  inventario,
  formatearCOP,
  formatearNumero,
  formatearValorM2,
} from "../data/proyecto";
import { PRECIOS_M2 } from "../data/lotes";
import TituloSeccion from "./TituloSeccion.astro";
import PlanoLotes from "./PlanoLotes.astro";
import TablaLotes from "./TablaLotes.astro";
import Calculadora from "./Calculadora.tsx";

/**
 * Sección de lotes. La que convierte.
 *
 * Tres partes: plano interactivo → inventario lote por lote → simulador de pago.
 *
 * El h2 contiene literalmente "lotes en Guatapé", que es la keyword primaria.
 *
 * La calculadora es una isla React con client:visible: React no se descarga
 * hasta que el usuario llega aquí, así que la carga inicial de la página sigue
 * siendo cero JS de framework.
 */
---

<section id="lotes" class="bg-verde-800">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <TituloSeccion eyebrow="Lotes y precios" tono="oscuro">
      Los {inventario.disponibles} lotes en Guatapé, con su precio real
    </TituloSeccion>

    <p class="mt-7 max-w-2xl font-sans text-base leading-relaxed text-crema/70">
      Cada lote tiene precio propio, desde {formatearCOP(inventario.precioMin)}, y áreas de {
        formatearNumero(inventario.areaMin)
      } a {formatearNumero(inventario.areaMax)} m&sup2;. El valor por m&sup2; va de {
        formatearValorM2(PRECIOS_M2.min)
      } a {formatearValorM2(PRECIOS_M2.max)} según el tamaño del lote, así que la cifra que
      importa es el precio total: aquí está el de cada uno.
    </p>

    <PlanoLotes />
    <TablaLotes />
    <Calculadora client:visible />
  </div>
</section>
