---
import { porQueGuatape } from "../data/especificaciones";
import TituloSeccion from "./TituloSeccion.astro";

/**
 * Por qué Guatapé. Tres bloques sobre el entorno.
 *
 * PROHIBIDO cualquier promesa de rentabilidad, valorización o retorno: es
 * publicidad inmobiliaria en Colombia. Se habla de atributos del lugar.
 */
---

<section id="por-que-guatape" class="bg-crema">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <TituloSeccion eyebrow="El entorno" tono="claro">
      Por qué Guatapé
    </TituloSeccion>

    <ul class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        porQueGuatape.map((bloque, i) => (
          <li class="border-t border-dorado-500/40 pt-7">
            <span class="font-serif text-3xl text-dorado-600">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 font-serif text-2xl text-verde-800">{bloque.titulo}</h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-texto/70">{bloque.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
