---
import BaseLayout from "../layouts/BaseLayout.astro";
import { enlaceWhatsApp } from "../data/proyecto";
import { logo } from "../data/galeria";
import Boton from "../components/Boton.astro";

const wa = enlaceWhatsApp();
---

<BaseLayout
  title="Página no encontrada | Vista Hermosa Guatapé"
  description="La página que buscas no existe. Vuelve al proyecto de lotes campestres Vista Hermosa en Guatapé."
  noindex
>
  <main
    id="contenido"
    class="flex min-h-svh flex-col items-center justify-center bg-verde-800 px-5 py-20 text-center"
  >
    <img
      src={logo.emblema.src}
      alt=""
      width={logo.emblema.ancho}
      height={logo.emblema.alto}
      class="h-16 w-auto opacity-70"
      loading="eager"
    />

    <p class="mt-10 font-serif text-6xl text-dorado-400">404</p>

    <h1 class="mt-6 max-w-xl font-serif text-3xl text-crema sm:text-4xl">
      Esta página no existe
    </h1>

    <p class="mt-5 max-w-md font-sans text-base text-crema/70">
      Puede que el enlace esté mal escrito o que la página se haya movido.
    </p>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <Boton href="/" variante="primario" tamano="grande">Ver los lotes</Boton>
      <Boton
        href={wa}
        variante="secundario"
        tamano="grande"
        target="_blank"
        rel="noopener"
        data-evento="whatsapp_click"
        data-origen="404"
      >
        Escribir por WhatsApp
      </Boton>
    </div>
  </main>
</BaseLayout>
