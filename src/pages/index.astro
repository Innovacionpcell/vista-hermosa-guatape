---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import DatosClave from "../components/DatosClave.astro";
import Ubicacion from "../components/Ubicacion.astro";
import Tour360 from "../components/Tour360.astro";
import Galeria from "../components/Galeria.astro";
import Lotes from "../components/Lotes.astro";
import PorQueGuatape from "../components/PorQueGuatape.astro";
import Especificaciones from "../components/Especificaciones.astro";
import Contacto from "../components/Contacto.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFlotante from "../components/WhatsAppFlotante.astro";
import CtaSticky from "../components/CtaSticky.astro";
import { faqSchema } from "../data/faq";
import { hero, src, srcset } from "../data/galeria";

const title = "Lotes en Guatapé desde $45.000 el m² | Vista Hermosa";
const description =
  "10 lotes campestres en Guatapé con vista al embalse y a la Piedra del Peñol. Áreas de 3.500 a 10.000 m² desde $45.000/m². Recorrido virtual 360°.";
---

<BaseLayout title={title} description={description} faqSchema={faqSchema()}>
  <!-- La imagen del hero es el LCP: se precarga con el mismo srcset/sizes que
       usa el <picture>, para que el navegador reserve exactamente la variante
       que va a pintar y no descargue dos. -->
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href={src(hero.base, 1920)}
      imagesrcset={srcset(hero.base)}
      imagesizes="100vw"
      fetchpriority="high"
    />
  </Fragment>

  <Header />

  <main id="contenido">
    <Hero />
    <DatosClave />
    <Ubicacion />
    <Tour360 />
    <Galeria />
    <Lotes />
    <PorQueGuatape />
    <Especificaciones />
    <Contacto />
    <Faq />
  </main>

  <Footer />

  {/* Fuera de <main>: acompañan a toda la página, no son contenido */}
  <WhatsAppFlotante />
  <CtaSticky />
</BaseLayout>
