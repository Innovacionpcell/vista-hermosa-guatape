---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import DatosClave from "../components/DatosClave.astro";
import Ubicacion from "../components/Ubicacion.astro";
import Tour360 from "../components/Tour360.astro";
import Galeria from "../components/Galeria.astro";
import Lotes from "../components/Lotes.astro";
import PorQueGuatape from "../components/PorQueGuatape.astro";
import Especificaciones from "../components/Especificaciones.astro";
import Contacto from "../components/Contacto.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFlotante from "../components/WhatsAppFlotante.astro";
import CtaSticky from "../components/CtaSticky.astro";
import { faqSchema } from "../data/faq";
import { hero, src, srcset } from "../data/galeria";
import { inventario, proyecto, formatearCOP, formatearNumero } from "../data/proyecto";

/* El title lleva la cifra de CAMPAÑA (la misma del h1), no el mínimo calculado
   del inventario: el resultado de búsqueda y el titular de la página tienen que
   decir el mismo "desde". El rango de áreas sí es el real, derivado de lotes.ts.
   Ver el bloque "CIFRAS DE CAMPAÑA" en src/data/proyecto.ts. */
const desde = formatearCOP(proyecto.precioDesdeComercial);

const title = `Lotes en Guatapé desde ${desde} | Vista Hermosa`;
const description = `${inventario.disponibles} lotes campestres en Guatapé con vista al embalse y a la Piedra del Peñol. Áreas de ${formatearNumero(inventario.areaMin)} a ${formatearNumero(inventario.areaMax)} m², desde ${desde}. Recorrido virtual 360°.`;
---

<BaseLayout title={title} description={description} faqSchema={faqSchema()}>
  <!-- La imagen del hero es el LCP: se precarga con el mismo srcset/sizes que
       usa el <picture>, para que el navegador reserve exactamente la variante
       que va a pintar y no descargue dos. -->
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href={src(hero.base, 1920)}
      imagesrcset={srcset(hero.base)}
      imagesizes="100vw"
      fetchpriority="high"
    />
  </Fragment>

  <Header />

  <main id="contenido">
    <Hero />
    <DatosClave />
    <Ubicacion />
    <Tour360 />
    <Galeria />
    <Lotes />
    <PorQueGuatape />
    <Especificaciones />
    <Contacto />
    <Faq />
  </main>

  <Footer />

  {/* Fuera de <main>: acompañan a toda la página, no son contenido */}
  <WhatsAppFlotante />
  <CtaSticky />
</BaseLayout>
